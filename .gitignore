# VaultPass Desktop - .gitignore
# Strictly configured to ensure no user credentials, build binaries, or secrets are tracked.

# ==========================================
# 1. Local Vault Data, Keys & Exports (CRITICAL)
# ==========================================
# Never commit user databases, DPAPI session keys, or exported credentials.
/data/
data/
# Source packages named "data" hold app code, not vault data, and must be tracked.
!src/**/data/
.vaultpass/
.vaultpass-dev/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.dpapi
session.dpapi
sync-device-id
metadata.json
settings.json
portable.flag
*.vpex
*.vpb
# Also numbered copies such as "vaultpass_export (1).csv".
vaultpass_backup*
vaultpass_export*

# ==========================================
# 2. Build Outputs & Generated Installers
# ==========================================
# Gradle outputs, Compose Desktop binaries, and Inno Setup distributions.
/build/
build/
/out/
out/
/dist/
dist/
*.exe
*.msi
*.dmg
*.pkg
*.deb
*.rpm
*.zip
*.tar.gz
*.7z

# Ignore compiled Java archives except the Gradle Wrapper jar.
*.jar
*.war
*.ear

# ==========================================
# 3. Gradle & Kotlin Caches
# ==========================================
/.gradle/
.gradle/
/.kotlin/
.kotlin/
/Installer
installer/
local.properties

# ==========================================
# 4. IDE & Editor Configurations
# ==========================================
/.idea/
.idea/
*.iml
*.iws
*.ipr
/.vscode/
.vscode/
/.fleet/
.fleet/

# ==========================================
# 5. OS-Generated Metadata
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ==========================================
# 6. Logs, Crash Dumps & Temporary Files
# ==========================================
*.log
crash.log
hs_err_pid*
replay_pid*
# Heap dumps can contain decrypted passwords.
*.hprof
*~
*.swp
*.swo
*.tmp
*.bak
error.txt

# ==========================================
# 7. Signing Keys, Certificates & Secrets
# ==========================================
*.jks
*.keystore
*.key
*.pem
*.p12
*.pfx
*.pvk
*.spc
key.properties
keystore.properties
signing.properties
service-account*.json
.env
.env.*
secrets.json
*.secret

# ==========================================
# 8. Explicit Inclusions
# ==========================================
# Track Gradle wrapper JAR for reproducible builds.
!gradle/wrapper/gradle-wrapper.jar
# The update signing PUBLIC key is the trust anchor for app updates and must be committed.
# The private key (.p12) stays outside the repository.
!src/main/resources/update-signing-key.pem
