# VaultPass Desktop - .gitignore
# This file is explicitly configured for the VaultPass Kotlin/Compose Desktop project.

# ==========================================
# 1. Build Outputs & Generated Artifacts
# ==========================================
# Ignore standard Gradle build directories which contain compiled classes and resources.
/build/
/out/
# Ignore generated binaries and packaged desktop installers (Compose Desktop output).
*.exe
*.msi
*.dmg
*.pkg
*.deb
*.rpm
# Ignore Java archives except the Gradle wrapper (which is explicitly included below).
*.jar
*.war
*.ear

# ==========================================
# 2. Gradle Caches & Configuration
# ==========================================
# Ignore Gradle's local cache and daemon files which are machine-specific.
/.gradle/
# local.properties contains local paths (like SDK locations) and must not be committed.
local.properties

# ==========================================
# 3. IntelliJ IDEA / Android Studio Files
# ==========================================
# Ignore IDE-specific project configuration files, caches, and workspace states.
/.idea/
*.iml
*.iws
*.ipr

# ==========================================
# 4. OS-Generated Files
# ==========================================
# Ignore metadata files generated by macOS and Windows.
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ==========================================
# 5. Logs & Temporary Files
# ==========================================
# Ignore runtime logs and application crash reports.
*.log
# Ignore temporary backup files generated by text editors.
*~
*.swp
*.tmp
*.bak
# Ignore current temporary error log file in the project.
error.txt

# ==========================================
# 6. Secrets, Credentials & Signing Keys
# ==========================================
# STRICTLY IGNORE all files that could contain cryptographic keys or environment secrets.
# VaultPass is a security application; these files must never leave the local machine.
*.jks
*.keystore
*.key
*.pem
key.properties
# Ignore environment and secrets files.
.env
.env.*
secrets.json
*.secret

# ==========================================
# 7. Explicit Inclusions
# ==========================================
# Ensure the Gradle Wrapper jar is tracked so developers can build without a local Gradle installation.
!gradle/wrapper/gradle-wrapper.jar
